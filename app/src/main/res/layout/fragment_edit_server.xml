<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/Toolbar.Clique" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_name"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/name"
            style="@style/Field"
            android:hint="@string/app_name"
            android:inputType="textCapWords"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/server_url"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/url"
            style="@style/Field"
            android:hint="@string/server_url_hint"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ca_pem"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/ca_pem"
            style="@style/Field"
            android:hint="@string/ca_pem_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/device_name"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/device_name"
            style="@style/Field"
            android:inputType="textCapWords"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pairing_code"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/code"
            style="@style/Field"
            android:hint="@string/pairing_code_hint"
            android:inputType="textCapCharacters"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_accent"
            android:text="@string/pair"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/pair_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/field_bg"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:text="@string/remove_server"
            android:textAllCaps="false"
            android:textColor="@color/error"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
